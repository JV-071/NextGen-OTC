Module
  name: game_helper
  description: Paulistinha Helper adapted for NextGen-OTC
  author: PaulistinhaOT / NextGen-OTC adaptation
  sandboxed: true
  reloadable: true
  scripts: [ helper_healer, helper_heal_friend, helper_target, helper_posture, helper_shooter, helper_tools, helper_conditions, helper_autoparty, helper_config, helper_cavebot, game_helper ]
  autoload: true
  autoload-priority: 1200
  dependencies:
    - game_interface
    - game_mainpanel
    - game_actionbar
  @onLoad: init()
  @onUnload: terminate()
